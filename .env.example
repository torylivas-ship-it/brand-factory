# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # never expose this on frontend
SUPABASE_ANON_KEY=your-anon-key-here              # safe to use on frontend

# Stripe
STRIPE_SECRET_KEY=sk_live_...                     # use sk_test_ for dev
STRIPE_WEBHOOK_SECRET=whsec_...                   # from Stripe Dashboard > Webhooks

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_LIFETIME=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_LIFETIME=price_...

# OpenAI
OPENAI_API_KEY=sk-...

# App
FRONTEND_URL=https://your-frontend.vercel.app    # no trailing slash

# AutoPost (social OAuth) — required, no default fallback
OAUTH_JWT_SECRET=generate-with-python-c-import-secrets-print-secrets-token-hex-32
OAUTH_TOKEN_ENCRYPTION_KEY=generate-with-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key().decode()
